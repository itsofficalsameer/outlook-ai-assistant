# Development Mode Configuration
# Set MOCK_MODE=True to run with 10 sample emails without requiring Microsoft login/credentials.
# Set MOCK_MODE=False to authenticate against real Microsoft Graph API.
MOCK_MODE=True

# Microsoft Entra ID (Azure AD) Application / Client ID
# Required only when MOCK_MODE=False
CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID

# Authority URL (optional, defaults to common for both personal and work/school accounts)
# Use 'https://login.microsoftonline.com/common' for any Microsoft account
# Use 'https://login.microsoftonline.com/consumers' for personal Microsoft accounts only
# Use 'https://login.microsoftonline.com/<tenant-id>' for a specific organization tenant
AUTHORITY=https://login.microsoftonline.com/common

# Groq AI Configuration
# Required for AI email analysis & meeting alarm extraction
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b
